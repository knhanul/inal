{
  "name": "inal-mobile-weather",
  "version": "0.1.0",
  "private": true,
  "description": "이날(Inal) — 이야기가 있는 날씨 (모바일 전용 날씨 조회·비교·이야기 웹서비스)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/knhanul/inal.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node server/proxy.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "start": "NODE_ENV=production node server/proxy.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@tanstack/react-query": "^5.56.2",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
